PORT=5050
# Only matters if you put a reverse proxy (e.g. Nginx) in front on a different
# port — used to build public URLs (thumbnails, etc). Leave equal to PORT for
# local dev. install.sh sets this to 80 on a production deploy.
PUBLIC_PORT=5050
RTMP_PORT=1935
HTTP_MEDIA_PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/unlimited-stream
JWT_SECRET=replace-with-random-secret
SERVER_IP=127.0.0.1
CORS_ORIGIN=http://localhost:3000
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

NODE_ENV=production
COOKIE_SECURE=true
WP_JOIN_SECRET=replace-with-random-secret
ROOM_SESSION_SECRET=replace-with-random-secret
PUBLIC_BASE_URL=https://example.com
ALLOW_PUBLIC_REGISTER=false
LIVEKIT_ENABLED=false
LIVEKIT_URL=https://livekit.example.com
LIVEKIT_WS_URL=wss://livekit.example.com
LIVEKIT_API_KEY=replace-with-livekit-key
LIVEKIT_API_SECRET=replace-with-livekit-secret
